# 复制为 .env 后填写。所有脚本通过 source .env 读取。

# ---- 必填：目标内核版本串，逐字符取自设备 uname -r ----
# 例：6.6.66-android15-8-gd43086512890-abogki423825152-4k
KERNEL_RELEASE=""

# ---- 必填：内核源码 ----
KERNEL_REPO=""
KERNEL_REF="master"
DEFCONFIG="gki_defconfig"

# ---- 必填：KernelSU 二改源 ----
# 默认 BakaSU（原 ReSukiSU），最新测试版 v4.2.0-rc3
KSU_REPO="https://github.com/Baka-SU/BakaSU"
KSU_REF="v4.2.0-rc3"

# ---- 构建模式 ----
# builtin：KSU 编进内核镜像（推荐，开机即生效）
# module ：编成 kernelsu.ko，走 LKM（需额外注入加载时机）
KSU_MODE="builtin"

# ---- 挂钩方式 ----
# upstream：用 BakaSU 自带的 LSM hook + syscall redirect，默认，不要动
# manual  ：额外往内核源码插 syscall 接管点，仅在上游 hook 挂不上时用
HOOK_MODE="upstream"

# ---- 页大小：留空则从 KERNEL_RELEASE 后缀自动推导（-4k / -16k）----
PAGE_SIZE=""

# ---- 可选：重打包用的原厂 boot.img ----
STOCK_BOOT=""

# ---- 可选：magiskboot 路径 ----
MAGISKBOOT=""

# ---- 编译并行度：留空用 nproc ----
JOBS=""
