# 复制为 .env 后填写。所有脚本通过 source .env 读取。

# ---- 必填：目标内核版本串，逐字符取自设备 uname -r ----
# 例：6.6.66-android15-8-gd43086512890-abogki423825152-4k
KERNEL_RELEASE=""

# ---- 必填：内核源码 ----
KERNEL_REPO=""
KERNEL_REF="master"
DEFCONFIG="gki_defconfig"

# ---- 必填：KernelSU 二改源 ----
# 默认 xc254726/sbsu（BakaSU 派生，管理器 rebrand 为 rue），跟 main 最新
KSU_REPO="https://github.com/xc254726/sbsu"
KSU_REF="main"

# ---- 构建模式 ----
# builtin：KSU 编进内核镜像（推荐，开机即生效）
# module ：编成 kernelsu.ko，走 LKM（需额外注入加载时机）
KSU_MODE="builtin"

# ---- 挂钩方式（对应 Kconfig 里三选一的 choice）----
# upstream：Tracepoint Syscall Redirect，GKI 2.0 / 5.10+ 默认，最稳
# manual  ：Manual Hook，内核裁掉 tracepoint 时用，兼容到 3.4
# susfs   ：SUSFS Inline Hook，需要 SUSFS 隐藏能力时才选
HOOK_MODE="upstream"

# ---- 页大小：留空则从 KERNEL_RELEASE 后缀自动推导（-4k / -16k）----
PAGE_SIZE=""

# ---- 可选：重打包用的原厂 boot.img ----
STOCK_BOOT=""

# ---- 可选：magiskboot 路径 ----
MAGISKBOOT=""

# ---- 编译并行度：留空用 nproc ----
JOBS=""

# ============ APK 侧（make ksud / manager / apk 用）============

# APK 构建类型：release 或 debug
APK_BUILD_TYPE="release"

# 要注入 ksud 的 ABI，逗号分隔。真机只需 arm64-v8a
KSUD_ARCHES="arm64-v8a"

# 可选：签名。都不填时 pack-apk.sh 会生成临时签名（不能覆盖官方版，需先卸载）
KEYSTORE_FILE=""
KEYSTORE_PASSWORD=""
KEY_ALIAS=""
KEY_PASSWORD=""

# 可选：覆盖 APK 的包名与显示名（留空沿用二改源默认 com.rue.manager / rue）
KSU_PACKAGE_NAME=""
KSU_NAME=""
