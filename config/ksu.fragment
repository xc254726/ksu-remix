# KernelSU 二改 —— kconfig fragment
# 用法：合并进 .config 后由 scripts/build.sh 校验
#
# KSU_MODE=builtin 时用 CONFIG_KSU=y
# KSU_MODE=module  时用 CONFIG_KSU=m（脚本会自动替换下面那行）

CONFIG_KSU=y

# --- 挂钩方式 ---
# HOOK_MODE=kprobe：依赖 kprobe 动态插桩，原版行为
CONFIG_KSU_KPROBES_HOOK=y

# --- 安全模式 ---
# 音量下键触发，能救回因模块导致的 bootloop
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# --- 注意：以下两项由 scripts/config.sh 动态写入，不要在此手填 ---
# CONFIG_LOCALVERSION="-<目标内核版本后缀>"
# CONFIG_ARM64_4K_PAGES=y / CONFIG_ARM64_16K_PAGES=y
