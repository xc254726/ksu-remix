# KernelSU 二改 —— kconfig fragment
# 目标：BakaSU（Baka-SU/BakaSU，原 ReSukiSU）
#
# 注意：BakaSU 的 Kconfig 只有 CONFIG_KSU 及若干 KSU_* 附加项，
# 没有 CONFIG_KSU_KPROBES_HOOK（那是 SukiSU/KowSU 的选项）。
# 它靠 LSM hook + syscall redirect 生效，编进内核即可，无需额外 hook 开关。

CONFIG_KSU=y

# 调试模式：排查时可开，日志更详细，性能略降
# CONFIG_KSU_DEBUG is not set

# --- 安全模式 ---
# 音量下键触发，能救回因模块导致的 bootloop
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# --- 注意：以下两项由 scripts/config.sh 动态写入，不要在此手填 ---
# CONFIG_LOCALVERSION="-<目标内核版本后缀>"
# CONFIG_ARM64_4K_PAGES=y / CONFIG_ARM64_16K_PAGES=y
